# Required. Generate with: openssl rand -hex 32
MCP_TOKEN=

# --- Optional overrides (defaults shown) ---
# Bind address. Keep 127.0.0.1 - the tunnel only needs loopback.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp

# Default per-command timeout in seconds.
# MCP_DEFAULT_TIMEOUT=60

# Max characters returned per stream (head+tail kept, middle truncated).
# MCP_MAX_OUTPUT=40000

# Comma-separated command allow-list. Empty = allow everything (full shell).
# Example: MCP_ALLOWLIST=ls,cat,grep,git,python3
# MCP_ALLOWLIST=

# Audit log location.
# MCP_LOG_FILE=~/.pc-shell/audit.log
