# GitHub OAuth App callback: https://<machine>.<tailnet>.ts.net/auth/callback
GH_CLIENT_ID=
GH_CLIENT_SECRET=
ALLOWED_GITHUB_USERS=
MCP_BASE_URL=https://<machine>.<tailnet>.ts.net

# Generate once; install.sh does this automatically for a new .env.
MCP_JWT_SIGNING_KEY=
MCP_STORAGE_KEY=

# Optional runtime limits.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_DEFAULT_TIMEOUT=60
# MCP_MAX_TIMEOUT=600
# MCP_MAX_OUTPUT=0
# MCP_MAX_CONCURRENT=4
# MCP_OAUTH_DIR=~/.pc-shell/oauth
