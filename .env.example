# ============================================================================
# pc-shell MCP server configuration.
# Copy to .env and fill in. The systemd service loads this file (EnvironmentFile).
# ============================================================================

# --- REQUIRED: GitHub OAuth (interactive clients: ChatGPT / Notion / Claude) ---
# Create a GitHub OAuth App:
#   GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#     Homepage URL:               https://<machine>.<tailnet>.ts.net
#     Authorization callback URL: https://<machine>.<tailnet>.ts.net/auth/callback
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# REQUIRED: comma-separated GitHub usernames allowed to call tools.
# Example: ALLOWED_GITHUB_USERS=octocat,another-user
ALLOWED_GITHUB_USERS=

# REQUIRED: stable key that signs issued OAuth tokens (keeps logins valid across
# restarts). Generate once with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_JWT_SIGNING_KEY=

# REQUIRED: public base URL of this server (must match the OAuth callback host).
MCP_BASE_URL=https://<machine>.<tailnet>.ts.net

# --- OPTIONAL: static bearer token for machine / fallback access ---
# Leave empty to run OAuth-only. Sent either as `Authorization: Bearer <token>`
# or as `?token=<token>` in the URL. Generate with: openssl rand -hex 32
MCP_TOKEN=

# --- Optional overrides (defaults shown) ---
# Where registered OAuth clients are persisted (survives restarts).
# MCP_OAUTH_STORE_DIR=~/.pc-shell/oauth

# Bind address. Keep 127.0.0.1 - the tunnel only needs loopback.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp

# Default per-command timeout in seconds.
# MCP_DEFAULT_TIMEOUT=60

# Max characters returned per stream (head+tail kept, middle truncated).
# MCP_MAX_OUTPUT=40000

# Comma-separated command allow-list. Empty = allow everything (full shell).
# Example: MCP_ALLOWLIST=ls,cat,grep,git,python3
# MCP_ALLOWLIST=

# Audit log location.
# MCP_LOG_FILE=~/.pc-shell/audit.log
