[Unit]
Description=pc-shell MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python __APP_DIR__/server.py
Restart=always
RestartSec=3
# --- lightweight hardening (no containers needed) ---
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# The shell tool needs to write in your home; scope it to what you use.
ReadWritePaths=__HOME__

[Install]
WantedBy=multi-user.target
